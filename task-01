# ------------------------------------------------------------
# 1. Lists
# ------------------------------------------------------------

# Create a list containing numbers 1 to 5
numbers = [1, 2, 3, 4, 5]

# Append 6
numbers.append(6)

# Replace the second element with 10
numbers[1] = 10

# Print the list
print(numbers)


# ------------------------------------------------------------
# 2. List Operations
# ------------------------------------------------------------

my_list = ['apple', 'banana', 'cherry', 'date']

# Access the first element
print(my_list[0])

# Remove the last element
my_list.pop()

# Insert 'grape' at index 2
my_list.insert(2, 'grape')

# Print modified list
print(my_list)


# ------------------------------------------------------------
# 3. Sets
# ------------------------------------------------------------

my_set = {1, 2, 3, 4}

# Add 5
my_set.add(5)

# Try to add 3 again
# Nothing happens because sets do not allow duplicate values
my_set.add(3)

# Remove 2
my_set.remove(2)

# Print final set
print(my_set)


# ------------------------------------------------------------
# 4. Set Operations
# ------------------------------------------------------------

my_set = {'red', 'green', 'blue'}

# Check if green is present
print('green' in my_set)

# Add yellow
my_set.add('yellow')

# Remove red
my_set.remove('red')

# Print modified set
print(my_set)


# ------------------------------------------------------------
# 5. Tuples
# ------------------------------------------------------------

my_tuple = (1, 2, 3, 4, 5)

# Access the third element
print(my_tuple[2])

# Tuples cannot be modified
# my_tuple[1] = 10
# This would give: TypeError

# Print tuple
print(my_tuple)


# ------------------------------------------------------------
# 6. Tuple Operations
# ------------------------------------------------------------

my_tuple = ('apple', 'banana', 'cherry')

# Access the last element
print(my_tuple[-1])

# Check if banana exists
print('banana' in my_tuple)

# Print tuple
print(my_tuple)


# ------------------------------------------------------------
# 7. Dictionaries
# ------------------------------------------------------------

my_dict = {
    'name': 'John',
    'age': 25,
    'city': 'New York'
}

# Access name
print(my_dict['name'])

# Change age to 26
my_dict['age'] = 26

# Add job
my_dict['job'] = 'Engineer'

# Print modified dictionary
print(my_dict)


# ------------------------------------------------------------
# 8. Dictionary Operations
# ------------------------------------------------------------

my_dict = {
    'brand': 'Toyota',
    'model': 'Corolla',
    'year': 2019
}

# Access model
print(my_dict['model'])

# Remove year
del my_dict['year']

# Add color
my_dict['color'] = 'blue'

# Print modified dictionary
print(my_dict)


