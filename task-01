# 1. Create fruits and vegetables tuples
fruits = ('Apple', 'Banana', 'Mango', 'Orange', 'Pear')

vegetables = ('Tomato', 'Potato', 'Carrot', 'Onion')


# 2. Join fruits and vegetables
fruits_vegetables = fruits + vegetables


# 3. How many fruits and vegetables?
print(len(fruits_vegetables))


# 4. Add mushroom and beverage
mushroom = ('Mushroom',)

beverage = ('Coffee',)

food_tuple = fruits_vegetables + mushroom + beverage

print(food_tuple)


